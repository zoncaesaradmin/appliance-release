UPSTREAM_IMAGE=docker.io/ollama/ollama:0.17.1
CACHE_NAME=ollama
# Base tag only — scripts append -${TARGET_ARCH}.
CACHE_TAG_BASE=0.17.1
# vLLM pins already encode arch in the tag / image name (cpu x86_64 vs arm64).
VLLM_UPSTREAM_IMAGE=docker.io/vllm/vllm-openai-cpu:v0.17.1-x86_64
VLLM_CACHE_NAME=vllm-openai-cpu
VLLM_CACHE_TAG=0.17.1-x86_64
VLLM_LOCAL_REF=localhost/build-cache/vllm-openai-cpu:0.17.1-x86_64
VLLM_ARM64_UPSTREAM_IMAGE=docker.io/vllm/vllm-openai:v0.29.0
VLLM_ARM64_CACHE_NAME=vllm-openai
VLLM_ARM64_CACHE_TAG=0.29.0-arm64
VLLM_ARM64_LOCAL_REF=localhost/build-cache/vllm-openai:0.29.0-arm64
