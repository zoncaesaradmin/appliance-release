ZOT_VERSION=v2.1.8
# ZOT_IMAGE / ZOT_CACHE_NAME / ZOT_LOCAL are derived from TARGET_ARCH in scripts
# (arch is in the image name: zot-linux-${TARGET_ARCH}).
DEBIAN_UPSTREAM=docker.io/library/debian:bookworm-slim
DEBIAN_CACHE_NAME=debian-bookworm-slim-runtime
# Base tag only — scripts append -${TARGET_ARCH}.
DEBIAN_CACHE_TAG_BASE=bookworm-slim
