# Official Jellyfin 10.10.7 Linux/amd64 source manifest. The appliance
# re-export uses the canonical OCI manifest below, which is pinned separately
# because its media type differs from Docker Hub's source manifest.
UPSTREAM_IMAGE=docker.io/jellyfin/jellyfin@sha256:3b38dae4c3ddd6ebc7378538fba4d3f314070ebefbdb3d688166b7c8658fb123
CACHE_NAME=jellyfin
# The source digest is part of the cache identity. A version-only mutable tag
# can retain an older upstream manifest and defeat OFFLINE_BUILD's pin.
CACHE_TAG=10.10.7-amd64-3b38dae4c3dd
LOCAL_REF=localhost/build-cache/jellyfin:10.10.7-amd64-3b38dae4c3dd
# Canonical OCI archive manifest produced by the pinned source above using the
# current shared export path. This is the digest workload manifests consume.
RUNTIME_REFERENCE=registry.local/jellyfin@sha256:097b8601dab0a261cddae37e14d8d65c561d3a6009ecae7ac6b13b960c9e4657
