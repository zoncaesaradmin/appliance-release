# Must match appliance-code/services/open-webui/source.lock exactly. The LAN
# seed is a shallow checkout archive, not an unreviewed upstream image.
UPSTREAM_URL=https://github.com/open-webui/open-webui.git
UPSTREAM_REF=v0.11.4
UPSTREAM_COMMIT=8bd8b4fac5e059578ac0c74b3c18d11139f88b7d
SOURCE_ARCHIVE=open-webui-source.tar.gz

# Exact Dockerfile FROM pins for v0.11.4 (USE_SLIM build). Seeded into
# build-cache with -${TARGET_ARCH} so offline packaging can --pull-never.
NODE_UPSTREAM=docker.io/library/node:22-alpine3.20
NODE_CACHE_NAME=open-webui-node
NODE_CACHE_TAG_BASE=22-alpine3.20

PYTHON_UPSTREAM=docker.io/library/python:3.11-slim-bookworm
PYTHON_CACHE_NAME=open-webui-python
PYTHON_CACHE_TAG_BASE=3.11-slim-bookworm
