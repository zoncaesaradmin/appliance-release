GOLANG_UPSTREAM=docker.io/library/golang:1.26
GOLANG_CACHE_NAME=golang
# Base tags only — scripts append -${TARGET_ARCH} so amd64/arm64 seeds do not collide.
GOLANG_CACHE_TAG_BASE=1.26

NODE_UPSTREAM=docker.io/library/node:22-alpine
NODE_CACHE_NAME=node
NODE_CACHE_TAG_BASE=22-alpine

ALPINE_UPSTREAM=docker.io/library/alpine:3.24.1
ALPINE_CACHE_NAME=alpine-3.24.1-runtime
ALPINE_CACHE_TAG_BASE=3.24.1

UI_DEPS_CACHE_NAME=controlplane-ui-web-deps
UI_DEPS_CACHE_TAG_BASE=lockfile
