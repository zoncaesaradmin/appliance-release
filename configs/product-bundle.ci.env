# CI defaults for scripts/build-full-bundle.sh.
#
# This is the single CI env file in this repo.
# Keep the stable defaults here. The outer CI script may optionally set:
# - PRODUCT_VERSION (overrides configs/default-product-version)
# - RELEASE_INPUT_SOURCE or RELEASE_INPUT_VERSION
# - K3s artifact source paths/URLs
# Host packages (mdns + wifi-ap) are always exported on the build host; no path override.

# ---------------------------------------------------------------------------
# Stable Defaults
# These usually do not change across ordinary CI runs.
# ---------------------------------------------------------------------------

# Build/export layout root. Export output is always ${RELEASE_WORK_ROOT}/export.
RELEASE_WORK_ROOT=${TMPDIR:-/tmp}/appliance-product-ci
# Default product source repositories for the normal CI flow.
# Override only when testing a different fork or branch source.
CODE_REPO_SOURCE=git@github.com:zoncaesaradmin/appliance-code.git
CTL_REPO_SOURCE=git@github.com:zoncaesaradmin/appliance-ctl.git
K3S_VERSION=v1.30.4+k3s1
HELM_VERSION=v3.21.1
CONTROL_PLANE_IMAGE_REPOSITORY=internal/control-plane-api
CHART_VERSION=
OS_VERSION=24.04
SAMPLE_MODE=0

# ---------------------------------------------------------------------------
# Runtime Values
# The CI driver script normally sets these when it runs.
# ---------------------------------------------------------------------------

# PRODUCT_VERSION: optional env override; otherwise configs/default-product-version.
RELEASE_INPUT_SOURCE=
RELEASE_INPUT_VERSION=
RELEASE_INPUT_FETCH_TEMPLATE=
INPUTS_DIR=${RELEASE_WORK_ROOT}/inputs
VALUES_FILE=
# Advanced overrides. Leave blank for the normal CI flow.
# If RELEASE_INPUT_SOURCE points at an appliance-code-produced artifact,
# the bundle flow derives the control-plane archive name from release-input.json
# and derives the image tag from codeVersion after the fetch step.
# HELM_VERSION pins the auto-downloaded Linux amd64 Helm binary when HELM_BINARY
# is not explicitly set.
HELM_BINARY=
CONTROL_PLANE_VERSION=
CONTROL_PLANE_IMAGE_REF=
CONTROL_PLANE_IMAGE=
K3S_BINARY=
K3S_AIRGAP_IMAGES=
